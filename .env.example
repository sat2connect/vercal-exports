# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Apps Script deployment URL.
# ---------------------------------------------------------------------------
#
# See the SETUP block at the top of apps-script/Code.gs for the full walkthrough:
#
#   1. Create a Google Sheet
#   2. Extensions > Apps Script, paste apps-script/Code.gs, Save
#   3. Deploy > New deployment > Web app
#        Execute as:     Me
#        Who has access: Anyone
#   4. Copy the /exec URL below
#   5. Restart the dev server (Vite only reads .env at startup)
#
# Only variables prefixed with VITE_ reach the browser, and they are embedded
# in the built JavaScript, so treat them as public. That is fine here: the
# endpoint only accepts appends and never exposes the Sheet's contents.

VITE_SHEETS_ENDPOINT=https://script.google.com/macros/s/your-deployment-id/exec
